# Copy this file to .env and fill in your own values.
# Never commit the real .env file to version control.

# --- Domain / URL ---
# The domain Caddy will request an SSL cert for and that Vikunja will use
# for links (e.g. password reset emails, share links).
DOMAIN=tasks.example.com
PUBLIC_URL=https://tasks.example.com

# --- Postgres ---
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=changeme_use_a_long_random_password
POSTGRES_DB=vikunja

# --- Vikunja ---
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_random_secret

# Timezone for due dates / reminders, e.g. Europe/Athens
TIMEZONE=Europe/Athens

# Server IP for easy make ssh command. Not needed on production
SERVER_IP=XX.XX.XX.XX

# --- Raw dependency graph export (see raw-graph-export/) ---
# API token from Vikunja Settings -> API Tokens (read access to tasks is enough).
VIKUNJA_API_TOKEN=
# Fallback if no token is set: username/password, exchanged for a JWT.
VIKUNJA_USERNAME=
VIKUNJA_PASSWORD=

# HTTP Basic Auth for the always-on /raw-graph endpoint (raw-graph-server).
# Both must be set or the endpoint rejects every request.
RAW_GRAPH_USERNAME=
RAW_GRAPH_PASSWORD=
